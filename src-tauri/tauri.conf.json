{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Modium",
	"version": "0.1.0",
	"identifier": "dev.fabricstudio.ide",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Modium",
				"width": 1320,
				"height": 820,
				"minWidth": 960,
				"minHeight": 620,
				"decorations": false,
				"backgroundColor": "#0D0F14"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"license": "MIT",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/icon.ico",
			"icons/icon.icns"
		]
	}
}